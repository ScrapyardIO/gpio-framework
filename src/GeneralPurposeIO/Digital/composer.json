{
    "name": "gpio/digital",
    "description": "The GeneralPurposeIO Digital package.",
    "type": "library",
    "version": "0.7.0",
    "keywords": [
        "framework",
        "scrapyard-io",
        "gpio",
        "digital-io"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/gpio-framework/0.6.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/gpio-framework/0.6.x/overview",
        "source": "https://github.com/scrapyard-io/gpio-framework",
        "issues": "https://github.com/scrapyard-io/gpio-framework/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/common": "0.7.0",
        "gpio/contracts": "0.7.0"
    },
    "suggest": {
        "microscrap/gpio": "POSIX Digital IO bindings for the PosixDigitalIOAdapter (^0.7)",
        "microscrap/mpsse": "MPSSE USB Digital IO for the MpsseDigitalIOAdapter (^0.7)",
        "scrapyard-io/gpio-framework": "Kitchen-sink metapackage that replaces gpio/digital at the same version (^0.7)"
    },
    "autoload": {
        "psr-4": {
            "GeneralPurposeIO\\Digital\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.7.x-dev",
            "dev-main": "0.7.x-dev",
            "dev-0.7.x": "0.7.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
