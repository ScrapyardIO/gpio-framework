            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "support": {
        "issues": "https://github.com/ScrapyardIO/gpio-framework/issues",
        "source": "https://github.com/ScrapyardIO/gpio-framework"
    },
    "require": {
        "php": "^8.3",
        "gpio/common": "0.6.0",
